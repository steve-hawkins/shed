{
  "name": "Shed — IDE Review & Orchestrator",
  "build": {
    "dockerfile": "./base/Dockerfile",
    "context": "."
  },
  "secrets": {
    "GRAFANA_OTLP_ENDPOINT": {
      "description": "Grafana Cloud OTLP HTTP endpoint URL (service.namespace=software-factory)"
    },
    "GRAFANA_OTLP_AUTH_HEADER": {
      "description": "Grafana Cloud Basic or Bearer Authorization header for OTLP ingestion"
    },
    "LITELLM_MASTER_KEY": {
      "description": "Master API key for LiteLLM AI Gateway administration"
    },
    "LITELLM_SALT_KEY": {
      "description": "Durable encryption salt key for LiteLLM virtual keys in PostgreSQL"
    },
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key for models routed via LiteLLM (optional if unused)"
    }
  },
  "remoteUser": "vscode",
  "securityOpt": [
    "seccomp=unconfined",
    "apparmor=unconfined"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "GitHub.vscode-pull-request-github",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "dotnet.defaultSolution": "Shed.sln",
        "editor.formatOnSave": true,
        "csharp.inlayHints.enableInlayHintsForParameters": true,
        "files.exclude": {
          "**/bin": true,
          "**/obj": true,
          "**/StrykerOutput": true
        }
      },
      "codespaces": {
        "repositories": {
          "steve-hawkins/shed": {
            "permissions": {
              "contents": "write",
              "pull_requests": "write",
              "issues": "write"
            }
          }
        }
      }
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    4000,
    4317,
    4318,
    18888,
    5000,
    5001
  ],
  "portsAttributes": {
    "4000": {
      "label": "LiteLLM AI Gateway",
      "onAutoForward": "silent"
    },
    "4317": {
      "label": "OTel Collector (gRPC)",
      "onAutoForward": "silent"
    },
    "4318": {
      "label": "OTel Collector (HTTP)",
      "onAutoForward": "silent"
    },
    "18888": {
      "label": "Aspire Dashboard (OTel)",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Telemetry Auditor API (HTTP)",
      "onAutoForward": "silent"
    },
    "5001": {
      "label": "Telemetry Auditor API (HTTPS)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "dotnet --info && semgrep --version && gitleaks version && dotnet stryker --version"
}
